#!/bin/sh

. /lib/functions/system.sh

case "$(board_name)" in
	fastrhino,r66s|lunzn,fastrhino-r66s) ;;
	*) exit 0 ;;
esac

# Keep an existing custom LAN address when upgrading with saved settings.
case "$(uci -q get network.lan.ipaddr)" in
	192.168.1.1|192.168.1.1/24) ;;
	*) exit 0 ;;
esac

uci set network.lan.ipaddr='192.168.77.1/24' || exit 1
uci commit network || exit 1

exit 0
